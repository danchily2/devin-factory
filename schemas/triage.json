{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danchily2/devin-factory/schemas/triage.json",
  "title": "Factory triage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "ready",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Visma-Manager/vmm",
          "Visma-Mobile-Employee/scarlet-team-c",
          "Visma-Mobile-Employee/scarlet-team-c-android"
        ]
      },
      "uniqueItems": true
    },
    "routing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "size": {
      "type": "string",
      "enum": [
        "S",
        "M",
        "L"
      ]
    },
    "needs_spec": {
      "type": "boolean"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "outcome",
    "summary",
    "repos",
    "routing_evidence",
    "size",
    "needs_spec",
    "open_questions",
    "acceptance_criteria"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "repos": {
            "minItems": 1
          },
          "routing_evidence": {
            "minItems": 1
          },
          "acceptance_criteria": {
            "minItems": 1
          },
          "open_questions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "blocked",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "open_questions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "needs_spec": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "size": {
            "const": "S"
          }
        }
      }
    }
  ]
}
